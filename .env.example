# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets
# GOOGLE_SHEET_ID is the long id in the sheet URL:
#   docs.google.com/spreadsheets/d/<THIS_PART>/edit
# The service account in credentials.json must be shared on that sheet as Editor.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=credentials.json

# Telegram
# TELEGRAM_BOT_TOKEN comes from @BotFather and looks like <digits>:<secret>.
# It must be ONE unbroken line - a space or line break makes it 401.
# TELEGRAM_WEBHOOK_SECRET is any random string you invent; it is echoed back by
# Telegram in the X-Telegram-Bot-Api-Secret-Token header so we can reject forgeries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Anthropic
# ANTHROPIC_MODEL is the only place the model id appears; change it here to switch.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
