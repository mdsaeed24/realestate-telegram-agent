.env
venv/
__pycache__/
*.pyc
.DS_Store
*.log
# Case variants matter: this only matched "Credentials.json" because macOS sets
# core.ignorecase. On Linux or CI it would not, and the key would be committable.
[Cc]redentials.json
[Cc]redentials.txt
*[Cc]redentials*.json
service-account*.json

# Local backups of secret files
.env.*
!.env.example

